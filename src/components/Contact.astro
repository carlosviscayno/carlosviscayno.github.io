---
import { site } from '../data/site';
---
<section data-page="contact" class="mx-auto max-w-[1280px] px-5 py-12 sm:px-8 lg:py-16">
  <div class="mx-auto max-w-2xl text-center">
    <p class="eyebrow reveal" style="--i:0">Say hello</p>
    <h2 class="reveal mt-3 text-5xl font-medium tracking-[-0.03em] sm:text-7xl" style="--i:1">Thank you!</h2>
    <p class="reveal mt-4 text-lg leading-relaxed text-ink-soft" style="--i:2">
      Thank you for spending a little time with my work. Whether you have a project in mind, a team that’s growing, or you simply want to say hello, I’d love to hear from you. Write your message below and it will open in your email app, ready to send.
    </p>
  </div>

  <form id="contact-form" data-email={site.email} class="card-plain reveal mx-auto mt-10 max-w-2xl space-y-6 !p-8" style="--i:3" novalidate>
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block text-sm font-medium">Your name
        <input class="field mt-2" name="name" type="text" required autocomplete="name" placeholder="Juan Dela Cruz" />
      </label>
      <label class="block text-sm font-medium">Your email
        <input class="field mt-2" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
      </label>
    </div>

    <fieldset>
      <legend class="text-sm font-medium">What is this about?</legend>
      <div class="mt-3 flex flex-wrap gap-2" id="inquiry-group">
        {[['project', 'A project'], ['job', 'A job or internship'], ['collab', 'Collaboration'], ['hello', 'Just saying hi']].map(([v, l], i) => (
          <label class="pill has-[:checked]:bg-active has-[:checked]:text-active-text has-[:checked]:border-active">
            <input type="radio" name="inquiry" value={v} class="sr-only" checked={i === 0} />{l}
          </label>
        ))}
      </div>
    </fieldset>

    {/* Dynamic field: only shown when "A project" is selected */}
    <label class="block text-sm font-medium" data-show-for="project">What do you need?
      <select class="field mt-2" name="need">
        <option>Logo design</option>
        <option>Brand identity</option>
        <option>Print design (posters, flyers, menus…)</option>
        <option>Merchandise</option>
        <option>Something else</option>
      </select>
    </label>

    {/* Dynamic field: only shown when "A job or internship" is selected */}
    <label class="block text-sm font-medium" data-show-for="job">Company or team
      <input class="field mt-2" name="company" type="text" placeholder="Where would I be working?" />
    </label>

    <label class="block text-sm font-medium">Message
      <textarea class="field mt-2" name="message" rows="5" required placeholder="Tell me a bit about your idea…"></textarea>
    </label>

    <label class="flex items-center gap-3 text-sm">
      <input type="checkbox" name="copy" class="size-5 rounded accent-[var(--color-brand-blue)]" /> Send me a copy of this message
    </label>

    <p id="form-error" class="is-filtered-out text-sm font-medium text-coral-dark dark:text-coral-light" role="alert"></p>
    <button type="submit" class="btn btn-primary">Send message</button>
  </form>
</section>

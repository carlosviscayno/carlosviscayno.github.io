---
import { printCategories, printProjects } from '../data/site';
---
<section data-page="print-design" class="mx-auto max-w-[1280px] px-5 py-12 sm:px-8 lg:py-16">
  <nav aria-label="Breadcrumb" class="reveal mb-6 flex items-center gap-2 text-sm text-ink-muted" style="--i:0">
    <button data-go="projects" class="cursor-pointer font-medium text-ink-soft underline-offset-4 hover:underline">Projects</button>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Print Design</span>
  </nav>
  <p class="eyebrow reveal" style="--i:0">03 · Print Design</p>
  <h2 class="reveal mt-3 text-5xl font-medium tracking-[-0.03em] sm:text-7xl" style="--i:1">Print Design</h2>
  <p class="reveal mt-3 max-w-2xl text-ink-soft" style="--i:2">Merchandise / Posters & Flyers / Packaging Design / Brochures</p>

  <div class="reveal mt-8 flex flex-wrap items-center gap-2" style="--i:3" role="group" aria-label="Filter projects">
    <button class="pill is-active" data-filter="all" aria-pressed="true">All</button>
    {printCategories.map((c) => <button class="pill" data-filter={c} aria-pressed="false">{c}</button>)}
  </div>
  <p id="print-count" class="mt-4 text-sm text-ink-muted" aria-live="polite"></p>

  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {printProjects.map((p, i) => (
      <button
        data-project={p.id} data-cat={p.category}
        class={`card tile reveal flex cursor-pointer flex-col gap-5 !p-4 text-left ${p.tint}`}
        style={`--i:${i + 4}`}
        aria-label={`Open ${p.title}`}
      >
        <div class="overflow-hidden rounded-2xl bg-white/50">
          <img src={p.images[0]} alt={p.title} class="aspect-[4/3] w-full object-cover" loading="lazy" />
        </div>
        <div class="px-2 pb-2">
          <span class="chip bg-white/65">{p.category}</span>
          <h3 class="mt-3 text-2xl font-medium tracking-[-0.015em]">{p.title}</h3>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium">
            View project
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      </button>
    ))}
  </div>

  {/* Each project's detail panel (opened in the side drawer) */}
  {printProjects.map((p) => (
    <template id={`tpl-${p.id}`}>
      <span class="chip chip-yellow">{p.category}</span>
      <h3 class="mt-3 text-3xl font-medium tracking-[-0.02em]">{p.title}</h3>
      <div class="mt-4 space-y-3 leading-relaxed text-ink-soft">
        {p.description.map((para) => <p>{para}</p>)}
      </div>
      <div class="relative mt-6">
        <div data-carousel class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-smooth rounded-2xl">
          {p.images.map((src, n) => (
            <button class="w-full shrink-0 cursor-zoom-in snap-center overflow-hidden rounded-2xl bg-surface" data-lightbox={`p-${p.id}`} data-src={src} data-caption={`${p.title} — ${n + 1}`} aria-label={`Enlarge image ${n + 1}`}>
              <img src={src} alt={`${p.title} — ${n + 1}`} class="aspect-[4/3] w-full object-cover" />
            </button>
          ))}
        </div>
        {p.images.length > 1 && (
          <div class="mt-3 flex items-center justify-between">
            <span class="text-sm text-ink-muted" data-carousel-count>1 / {p.images.length}</span>
            <div class="flex gap-2">
              <button class="btn-icon" data-carousel-prev aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></button>
              <button class="btn-icon" data-carousel-next aria-label="Next image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></button>
            </div>
          </div>
        )}
      </div>
    </template>
  ))}
</section>

---
<div class="pointer-events-none fixed inset-x-0 bottom-5 z-30 flex justify-center px-4">
  <div class="pointer-events-auto flex items-center gap-3 rounded-full border border-hairline bg-canvas/90 px-3 py-2 shadow-mockup backdrop-blur">
    <button class="btn-icon" id="prev-page" aria-label="Previous page">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <div class="flex min-w-24 flex-col items-center">
      <span id="page-label" class="text-sm font-medium">Home</span>
      <span id="page-dots" class="mt-1 flex gap-1.5" aria-hidden="true"></span>
    </div>
    <button class="btn-icon" id="next-page" aria-label="Next page">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </div>
</div>
<div class="h-28"></div>

---
import { chapters } from '../data/site';
---
<section data-page="projects" class="mx-auto max-w-[1280px] px-5 py-12 sm:px-8 lg:py-16">
  <p class="eyebrow reveal" style="--i:0">Selected work</p>
  <h2 class="reveal mt-3 text-5xl font-medium tracking-[-0.03em] sm:text-6xl" style="--i:1">Projects</h2>
  <p class="reveal mt-3 text-ink-soft" style="--i:2">Logofolio | Branding | Print Design</p>

  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {chapters.map((c, i) => (
      <button data-go={c.id} class={`card tile reveal flex min-h-72 cursor-pointer flex-col justify-between text-left ${c.tint}`} style={`--i:${i + 3}`}>
        <span class="text-6xl font-medium tracking-[-0.04em] opacity-30">{c.number}</span>
        <span>
          <span class="block text-3xl font-medium tracking-[-0.02em]">{c.title}</span>
          <span class="mt-4 block text-base leading-relaxed">{c.blurb}</span>
          <span class="mt-3 block text-[13px] leading-relaxed opacity-65">{c.tags}</span>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium">
            Open chapter
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </span>
      </button>
    ))}
  </div>
</section>
